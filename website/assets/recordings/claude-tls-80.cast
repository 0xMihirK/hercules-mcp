[156.363302, "o", "\u001b[2D\u001b[3B\r\u001b[11A \u001b[3G\u001b[38;2;153;153;153mCalled hercules (ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✢\u001b[3GInvestigate, r\u001b[38;2;235;159;127meje\u001b[38;2;215;119;87mct alternatives and verify evidence… \u001b[38;2;153;153;153m(2m 9s)\r\u001b[1B  ⎿  \u001b[38;2;78;186;101m✔ \u001b[38;2;153;153;153m\u001b[9mEstablish scope and start the owned runtime\u001b[29m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;215;119;87m◼ \u001b[39m\u001b[1mInvestigate, reject alternatives and verify evidence\r\u001b[1B\u001b[22m     ◻ Write the report and clean up the owned runtime\u001b[K\r\u001b[1B\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[7m \u001b[27m\u001b[K\r\r\n\u001b[38;2;136;136;136m────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;2;153;153;153m⏸\u001b[5Gmanual\u001b[12Gmode\u001b[17Gon\u001b[20G·\u001b[22Gesc\u001b[26Gto\u001b[29Ginterrupt\u001b[39G·\u001b[41Gctrl+t\u001b[48Gto\u001b[51Ghide\u001b[56Gtasks\u001b[62G·\u001b[64G←\u001b[66Gfor\u001b[70Gagents\u001b[39m\r\r\n\u001b[2C\u001b[3A"]
