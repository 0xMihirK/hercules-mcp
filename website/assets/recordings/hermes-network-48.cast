[233.662418, "o", "\u001b[H\u001b[1C└─\u001b[1C▾\u001b[1CToo\u001b[2Ccalls\u001b[1C(1)\u001b[1C   \u001b[1C   \u001b[1C      \u001b[1C         \r\u001b[3C\u001b[1B└─ ●\u001b[1C🔌 Hercules\u001b[1C· recon dns (6.2s) \r\u001b[4C\u001b[1B       \u001b[1C      \u001b[1C       \u001b[1C          \r\u001b[4C\u001b[1BResp\u001b[1Cnse    \u001b[1C   \r\u001b[3C\u001b[1B  \u001b[1C \u001b[1C  \u001b[1C        \u001b[1C \u001b[1C     \u001b[1C   \u001b[1C      \r\u001b[1C\u001b[1B┊\u001b[2CDNS\u001b[1Cis\u001b[1Cconfirmed.\u001b[1CI\u001b[1Cwill\u001b[1Cmap\u001b[1Conly\u001b[1Cthe\r\u001b[1C\u001b[1B  \u001b[1Cthree \u001b[1Ccoped\u001b[1Cservice\u001b[1Cports;\u001b[1Can\u001b[1Copen\u001b[1Cport\r\u001b[4C\u001b[1Balone\u001b[1Cwill\u001b[1Cnot\u001b[1Cestablish\u001b[1Ca\u001b[1Cvulnerability.\r\u001b[1C\u001b[1B└─\u001b[1C▾ Tool\u001b[2Calls (1) \u001b[1C \u001b[1C    \u001b[1C   \u001b[1C    \u001b[1C   \r\u001b[3C\u001b[1B└─ ● 🔌 Hercules · nma\u001b[1C scan\u001b[1C(9.3s) \u001b[1C    \r\u001b[4C\u001b[1B     \u001b[1C    \u001b[1C   \u001b[1C         \u001b[1C \u001b[1C              \r\u001b[4C\u001b[1BResp\u001b[1Cnse    \u001b[1C   \r\u001b[3C\u001b[1B  \u001b[1C \u001b[1C  \u001b[1C        \u001b[1C \u001b[1C    \u001b[1C    \u001b[1C      \r\u001b[1C\u001b[1B┊\u001b[2CThe\u001b[1Cports\u001b[1Care\u001b[1Creachable.\u001b[1CI\u001b[1Cwill\u001b[1Cverify\r\u001b[1C\u001b[1B  \u001b[1Cs\u001b[1Crvice behavior\u001b[1Cwith\u001b[1Cversion\u001b[1Cdetection\r\u001b[4C\u001b[1Band\u001b[1Cretain\u001b[1Cboth\u001b[1Ctext\u001b[1Cand\u001b[1CXML\u001b[1Coutput.\r\u001b[1C\u001b[1B└─\u001b[1C▾ Tool calls (1)        \u001b[1C \u001b[1C    \u001b[1C      \r\u001b[3C\u001b[1B└─ ● 🔌 Hercules · shell exec nmap -Pn -sT\r\u001b[4C\u001b[1B  -sV --version-light -p\u001b[1C8000,8080,844…\r\u001b[6C\u001b[1B(39.7s)\r\u001b[1C\u001b[1B  \u001b[1C \u001b[1C    \u001b[1C     \u001b[1C   \r\u001b[1C\u001b[1B└─ Response       \u001b[1C \u001b[1C     \u001b[1C    \u001b[1C    \u001b[1C  