[250.078696, "o", "\u001b[H\u001b[3C└─ ● 🔌 Hercules · shell exec nmap -Pn -sT\r\u001b[4C\u001b[1B  -sV --version-light -p\u001b[1C8000,8080,844…\r\u001b[1C\u001b[1B  \u001b[1C \u001b[1C(39.7s)   \u001b[1C   \r\u001b[3C\u001b[1B  \u001b[1C \u001b[1C  \u001b[1C        \u001b[1C \u001b[1C     \u001b[1C    \u001b[1C    \u001b[1C   \u001b[1C   \r\u001b[1C\u001b[1B└─\u001b[1CResponse             \u001b[1C  \u001b[1C              \r\u001b[6C\u001b[1B       \r\u001b[1C\u001b[1B┊\u001b[2CI\u001b[1Cwill\u001b[1Cconfirm\u001b[1Cthat\u001b[1Cthe\u001b[1Cdiscovered\u001b[1CHTTP\r\u001b[1C\u001b[1B  \u001b[1Cs\u001b[1Crvice responds,\u001b[1Cretaining\u001b[1Cthe\u001b[1Cresponse\r\u001b[4C\u001b[1Bas\u001b[1Ca\u001b[1Cfile.\r\u001b[1C\u001b[1B└─\u001b[1C▾\u001b[1CToo\u001b[3Calls (1)   \u001b[1C   \u001b[1C          \u001b[1C    \r\u001b[3C\u001b[1B└─ ● 🔌 Hercules ·\u001b[1Cn\u001b[2Cwork curl (6.2s)   \r\u001b[4C\u001b[1B  \u001b[1C \u001b[1C     \r\u001b[4C\u001b[1BResp\u001b[1Cnse    \u001b[1C   \r\u001b[3C\u001b[1B  \u001b[1C \u001b[1C  \u001b[1C        \u001b[1C \u001b[1C       \u001b[1C    \u001b[1C      \r\u001b[1C\u001b[1B┊\u001b[2CThe\u001b[1CHTTP\u001b[1Cservice\u001b[1Cis\u001b[1Chealthy.\u001b[1CI\u001b[1Cwill\r\u001b[1C\u001b[1B  \u001b[1Cin\u001b[2Cect its\u001b[1Cdeclared\u001b[1Croutes\u001b[1Cbefore\r\u001b[4C\u001b[1Binterpreting\u001b[1Cwhat\u001b[1Cthe\u001b[1Capplication\r\u001b[1C\u001b[1B \u001b[2Cexposes.\u001b[1C       \u001b[1C  \u001b[1C        \u001b[1C \u001b[1C    \r\u001b[1C\u001b[1B└─\u001b[1C▾ Tool calls (1)    \u001b[1C      \u001b[1C      \r\u001b[3C\u001b[1B└─ ● 🔌 Hercules ·\u001b[1Cnetwork curl (6.3s)\r\u001b[4C\u001b[1B        \r\u001b[1C\u001b[1B└─\u001b[1CResponse\r\u001b[1C\u001b[1B  \u001b[1C \u001b[1C    \u001b[1C     \u001b[1C   \r\u001b[1C\u001b[1B┊\u001b[1C I\u001b[1Cwill\u001b[1Cv\u001b[2Cify the\u001b[1C       \u001b[1C    \u001b[1C      \u001b[28;1H"]
