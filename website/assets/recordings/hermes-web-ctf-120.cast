[140.043502, "o", "\u001b[H\u001b[3C   \u001b[1C         \u001b[1C     \u001b[1C   \u001b[1C     \u001b[1C   \u001b[1C     \u001b[1C       \r\u001b[1C\u001b[1B└─ ▾ Tool calls (1)      \u001b[1C            \u001b[1C   \u001b[1C      \u001b[1C        \r\u001b[3C\u001b[1B└─ ● Todo\u001b[1CList(\"\u001b[1Clanni\u001b[1Cg\u001b[1C3 t\u001b[1Csk(s)\") (0.0s)\u001b[1C       \r\u001b[4C\u001b[2BResp\u001b[1Cnse    \u001b[1C   \r\u001b[3C\u001b[1B  \u001b[1C \u001b[1C    \u001b[1C              \u001b[1C \u001b[1C         \u001b[1C      \r\u001b[1C\u001b[1B┊\u001b[2CConnecting\u001b[1CMCP\u001b[1Chas\u001b[1Cnot\u001b[1Cstarted\u001b[1CKali.\u001b[1CI\u001b[1Cwill\u001b[1Cexplicitly\u001b[1Cstart\u001b[1Cthe\u001b[1Cruntime\u001b[1Cbefore\u001b[1Cexecuting\u001b[1Ctools.\r\u001b[4C\u001b[1B▾ To\u001b[1Cl calls\u001b[1C(1)\r\u001b[3C\u001b[1B└─\u001b[1C●\u001b[1C🔌\u001b[1CHercules\u001b[1C·\u001b[1Csystem\u001b[1Cstart\u001b[1Ccontainer\u001b[1C(20.8s)\r\u001b[1C\u001b[1B \u001b[2C          \u001b[1C   \u001b[1C   \u001b[1C   \u001b[1C       \u001b[1C     \u001b[1C \u001b[1C    \u001b[1C          \u001b[1C     \u001b[1C   \u001b[1C       \u001b[1C      \u001b[1C         \u001b[1C      \r\u001b[4C\u001b[1BResp\u001b[1Cnse    \u001b[1C   \r\u001b[3C\u001b[1B  \u001b[1C \u001b[1C  \u001b[1C        \u001b[1C \u001b[1C      \u001b[1C     \u001b[1C         \u001b[1C       \r\u001b[1C\u001b[1B┊\u001b[2CMy\u001b[1Cowned\u001b[1Cruntime\u001b[1Cis\u001b[1Cready.\u001b[1CI\u001b[1Cwill\u001b[1Cverify\u001b[1Cthe\u001b[1Csupplied\u001b[1Cscope,\u001b[1Cinvestigate\u001b[1Cthe\u001b[1Cinternal\u001b[1Clab\u001b[1Cand\u001b[1Cstop\u001b[1Cthe\u001b[1Cruntime\r\u001b[1C\u001b[1B  \u001b[1Cafter r\u001b[1Cporting.\r\u001b[1C\u001b[1B└─\u001b[1C▾\u001b[1CTool\u001b[1Ccalls\u001b[1C(1)\r\u001b[1C\u001b[1B \u001b[1C└─ ● 🔌 He\u001b[1Ccules · wo\u001b[1Ckspace read file scope.md (6.1s)\u001b[1C      \u001b[1C           \u001b[1C   \u001b[1C        \u001b[1C   \u001b[1C   \u001b[1C    \u001b[1C   \u001b[1C       \r\u001b[4C\u001b[1B     \u001b[1C          \r\u001b[4C\u001b[1BResp\u001b[1Cnse    \u001b[1C   \r\u001b[3C\u001b[1B  \u001b[1C \u001b[1C  \u001b[1C        \u001b[1C \u001b[1C         \u001b[1C    \u001b[1C    \u001b[1C        \u001b[1C      \r\u001b[1C\u001b[1B┊\u001b[2CThe\u001b[1Cprevious\u001b[1Cphase\u001b[1Cpassed\u001b[1Cits\u001b[1Cevidence\u001b[1Cchecks.\u001b[1CI\u001b[1Cwill\u001b[1Cupdate\u001b[1Cthe\u001b[1Cplan\u001b[1Cbefore\u001b[1Ccontinuing.\r\u001b[4C\u001b[1B▾ To\u001b[1Cl calls\u001b[1C(1)\r\u001b[3C\u001b[1B└─\u001b[1C●\u001b[1CTodo\u001b[1CList(\"updating\u001b[1C3\u001b[1Ctask(s)\")\u001b[1C(0.0s)\r\u001b[1C\u001b[1B \u001b[2C   \u001b[1C        \u001b[1C     \u001b[1C      \u001b[1C   \u001b[1C        \u001b[1C       \u001b[1C \u001b[1C    \u001b[1C      \u001b[1C   \u001b[1C    \u001b[1C      \u001b[1C           \r\u001b[4C\u001b[1BResp\u001b[1Cnse    \u001b[1C   \r\u001b[3C\u001b[1B  \u001b[1C \u001b[1C    \u001b[1C              \u001b[1C \u001b[1C         \u001b[1C      \r\u001b[1C\u001b[1B┊\u001b[2CI\u001b[1Cwill\u001b[1Cinspect\u001b[1Cdeclared\u001b[1Croutes\u001b[1Cbefore\u001b[1Cguessing\u001b[1Cendpoints.\r\u001b[4C\u001b[1B▾ To\u001b[1Cl calls\u001b[1C(1)\r\u001b[3C\u001b[1B└─\u001b[1C●\u001b[1C🔌\u001b[1CHercules\u001b[1C·\u001b[1Cnetwork\u001b[1Ccurl\u001b[1C(6.5s)\r\u001b[1C\u001b[1B \u001b[2C \u001b[1C    \u001b[1C       \u001b[1C        \u001b[1C      \u001b[1C      \u001b[1C        \u001b[1C          \r\u001b[1C\u001b[1B└─\u001b[1CResponse\r\u001b[1C\u001b[1B  \u001b[1C \u001b[1C    \u001b[1C     \u001b[1C   \r\u001b[1C\u001b[1B┊\u001b[1C The\u001b[1Cdraft API is l       \u001b[1C    \u001b[1C      \u001b[36;1H"]
