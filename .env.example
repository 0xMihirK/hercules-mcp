# Hercules — Environment Configuration
# Copy this file to .env and adjust values as needed.

# Metasploit RPC password (used by msfrpcd and pymetasploit3 client)
MSF_PASSWORD=hercules

# Skip Metasploit setup (PostgreSQL, msfdb, msfrpcd) for faster startup
SKIP_METASPLOIT=false

# Keep the Kali container after server shutdown (for debugging)
PRESERVE_CONTAINER=false

# Use --privileged instead of minimal capabilities (NET_ADMIN, NET_RAW)
USE_PRIVILEGED=false

# Tool install mode: "minimal" (only essentials) | "headless" (kali-linux-headless) | "large" (kali-linux-large)
TOOL_INSTALL_MODE=minimal

# Concurrency limits
MAX_CONCURRENT_HEAVY=3
MAX_CONCURRENT_LIGHT=10

# Target safety controls (comma-separated, empty = allow all)
ALLOWED_TARGETS=
BLOCKED_TARGETS=

# ── Tool surface / token budget ──────────────────────────────────────────────
# Comma-separated MCP tool names to NOT register, trimming their description +
# schema from the model's context to save tokens. Opting out does NOT remove the
# binary from the image — the agent can still run it via shell_exec. Core tools
# (shell_*, system_*, workspace_*) can never be disabled. Easiest to manage via
# the interactive setup:  python hercules_setup.py
# Example: HERCULES_DISABLED_TOOLS=browser_cmd,metasploit_search,ctf_steghide
HERCULES_DISABLED_TOOLS=

# Container resource limits (0 = unlimited)
CONTAINER_CPU_LIMIT=0
CONTAINER_MEM_LIMIT=0

# Default command timeout in seconds
DEFAULT_TIMEOUT=300

# ── Stealth browser (cloakbrowser + agent-browser) ───────────────────────────
# Run the stealth Chromium headless (true) or headed under Xvfb (false).
BROWSER_HEADLESS=true
# Forward a headed live-view/stream port from the container to the host so you
# can WATCH the agent drive the browser. 0 = disabled. Only meaningful when
# BROWSER_HEADLESS=false. Example: 4848
BROWSER_STREAM_PORT=0
# Optional default upstream proxy for browser sessions (e.g. http://127.0.0.1:8080)
BROWSER_PROXY=
# Optional default stealth timezone / locale (matched to your exit IP for realism)
BROWSER_TIMEZONE=
BROWSER_LOCALE=
