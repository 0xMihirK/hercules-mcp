# Hercules — Environment Configuration
# Copy this file to .env and adjust values as needed.

# Metasploit RPC password (used by msfrpcd and pymetasploit3 client).
# Leave blank in this template; the installing agent must generate a strong
# local value without printing it or storing it in MCP client configuration.
MSF_PASSWORD=
MSF_RPC_PORT=55553

# Skip Metasploit runtime services (PostgreSQL, msfdb, msfrpcd) for faster startup
SKIP_METASPLOIT=false

# Keep the Kali container after server shutdown (for debugging)
PRESERVE_CONTAINER=false

# Use --privileged instead of minimal capabilities (NET_ADMIN, NET_RAW)
USE_PRIVILEGED=false

# Concurrency limits
MAX_CONCURRENT_HEAVY=3
MAX_CONCURRENT_LIGHT=10

# Target safety controls (comma-separated, empty = allow all)
ALLOWED_TARGETS=
BLOCKED_TARGETS=

# ── Installed capabilities and tool surface ──────────────────────────────────
# Maintained by the installing agent. Use catalog keys; core is always added.
# An absent value on a legacy installation is interpreted as a full profile.
HERCULES_INSTALLED_CAPABILITIES=

# Comma-separated MCP tool names to NOT register, trimming their description +
# schema from the model's context. This independently hides an installed tool;
# it does not add binaries omitted from the capability-specific image. Core
# tools (shell_*, system_*, workspace_*) can never be disabled.
# Example: HERCULES_DISABLED_TOOLS=browser_cmd,metasploit_search,ctf_steghide
HERCULES_DISABLED_TOOLS=

# Container resource limits (0 = unlimited)
CONTAINER_CPU_LIMIT=0
CONTAINER_MEM_LIMIT=0

# Default command timeout in seconds
DEFAULT_TIMEOUT=300

# Workspace safety and bounded execution. Existing installs continue to use
# <checkout>/workspace unless HERCULES_WORKSPACE_ROOT is explicitly set.
HERCULES_WORKSPACE_ROOT=
# Managed reusable download/extraction cache. New agent-managed deployments keep
# this outside the Git checkout; legacy installs continue using wordlists/.
HERCULES_WORDLIST_ROOT=
# Fingerprint only. A custom certificate bundle is passed as a bounded BuildKit
# secret and must not be copied into this checkout or stored in setup state.
HERCULES_BUILD_CA_SHA256=
# Docker image platform. Hercules supports native/emulated Linux AMD64 and ARM64.
HERCULES_IMAGE_PLATFORM=
# Exact browser dependency facts used to identify and validate browser images.
HERCULES_CLOAKBROWSER_VERSION=0.5.3
HERCULES_CLOAKBROWSER_WHEEL_URL=https://files.pythonhosted.org/packages/93/e8/f0d86ca18b3a1e132ffd965268f621897f60c47ea8c61b1ee9a786fffb36/cloakbrowser-0.5.3-py3-none-any.whl
HERCULES_CLOAKBROWSER_SHA256=9082cfd2f104342fd718d9882984da7674ef6616308dd7932bff4b8bd5cf3cfe
HERCULES_MAX_INLINE_FILE_BYTES=8388608
HERCULES_MAX_CAPTURED_OUTPUT_BYTES=2097152
HERCULES_MAX_INLINE_RESPONSE_CHARS=12000
HERCULES_MAX_BACKGROUND_JOBS=8

# Evidence retention is opt-in. Zero limits disable the corresponding rule.
# Use `hercules-workspace prune` for a report before adding --apply.
HERCULES_WORKSPACE_AUTO_PRUNE=false
HERCULES_WORKSPACE_RETENTION_DAYS=0
HERCULES_WORKSPACE_MAX_SESSIONS=0
HERCULES_WORKSPACE_MAX_BYTES=0

# Reverse-listener ports intentionally published by Docker Desktop bridge mode.
# Accepts comma-separated ports and ranges such as 4444-4464,9001.
HERCULES_LISTENER_PORTS=4444-4464
HERCULES_LISTENER_BIND_HOST=0.0.0.0
# Let concurrent coding-agent/IDE sessions select the first collision-free RPC,
# listener, and browser-stream port set. Set false only when fixed ports are an
# explicit integration requirement; startup then fails if any port is busy.
HERCULES_AUTO_ALLOCATE_PORTS=true
# Optional existing Docker network (used for operator-managed isolated labs).
HERCULES_DOCKER_NETWORK=

# ── Stealth browser (cloakbrowser + agent-browser) ───────────────────────────
# Forward the selected session's live-view WebSocket to host loopback. Docker
# Desktop uses a private container relay port. 0 = disabled. Example: 4848
BROWSER_STREAM_PORT=0
# Optional default upstream proxy for browser sessions (e.g. http://127.0.0.1:8080)
# Authenticated HTTP(S) or SOCKS5 proxy used by new browser sessions.
BROWSER_PROXY_URL=
# Prevent WebRTC from sending UDP outside the configured proxy.
BROWSER_DISABLE_NON_PROXIED_UDP=true
# Optional default stealth timezone / locale (matched to your exit IP for realism)
BROWSER_TIMEZONE=
BROWSER_LOCALE=
